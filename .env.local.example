# Copy to .env.local.
# Hosted project: Supabase Dashboard → Project Settings → API Keys.
# Local stack: run `npx supabase status` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Older/local setups can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret/service-role key — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
